{% extends "./base.njk" %} {% block content %}
<div id="main-content" class="main-content">
  <main class="main-primary" id="main">
    <div class="container p-t-md">
      {# Breadcrumbs (rendering data from /src/_data/breadcrumbs.json and
      /src/_data/helpers.js #} {%- include
      "../../src/components/breadcrumbs.njk" -%}

      <div class="row">
        <div class="col-lg-3">
          <details
            class="side-navigation-toggle"
            aria-label="Toggle side navigation"
            aria-expanded="false"
            aria-controls="side-nav-content">
            <summary>
              <span class="container d-block">Get started</span>
            </summary>
          </details>
          {# SIde navigation (rendering data from /src/_data/sidenavigation.json
          and /src/_data/helpers.js #}
          <!-- Side navigation component -->
          <div class="container" id="side-nav-content">
            <nav
              aria-labelledby="getting-started"
              class="side-navigation sticky-6">
              {# Links with subnav #}
              <ul>
                {%- for item in sidenavigation.sidenavigation -%} {%- if
                'subnav' in item %}
                <li>
                  <a
                    href="{{ item.url }}"
                    {{
                    helpers.getLinkActiveState(item.url,
                    page.url)
                    |
                    safe
                    }}
                    >{{ item.text }}</a
                  >
                  {# subnav #}
                  <ul>
                    {%- for subitem in item.subnav %}
                    <li>
                      <a
                        href="{{ subitem.url }}"
                        {{
                        helpers.getLinkActiveState(subitem.url,
                        page.url)
                        |
                        safe
                        }}
                        >{{ subitem.text }}</a
                      >
                    </li>
                    {%- endfor -%}
                  </ul>
                </li>
                {%- else %}
                <li>
                  <a
                    href="{{ item.url }}"
                    {{
                    helpers.getLinkActiveState(item.url,
                    page.url)
                    |
                    safe
                    }}
                    >{{ item.text }}</a
                  >
                </li>
                {%- endif -%} {%- endfor -%}
              </ul>
            </nav>
          </div>
        </div>
        <div class="col-lg-9 p-b-lg">{{ content | safe }}</div>
      </div>
    </div>
  </main>
</div>
{%- endblock -%}
